{
  "version": 2,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;Distributed"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/out/build/debug"
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/out/build/release"
    },
    {
      "name": "distributed",
      "displayName": "Distributed",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/out/build/distributed",
      "cacheVariables": {
        "CMAKE_EXE_LINKER_FLAGS_DISTRIBUTED": "/INCREMENTAL:NO /LTCG /OPT:REF /OPT:ICF /DEBUG:FULL"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug-build",
      "configurePreset": "debug",
      "configuration": "Debug",
      "displayName": "Build Debug"
    },
    {
      "name": "release-build",
      "configurePreset": "release",
      "configuration": "Release",
      "displayName": "Build Release"
    },
    {
      "name": "distributed-build",
      "configurePreset": "distributed",
      "configuration": "Distributed",
      "displayName": "Build Distributed"
    }
  ]
}
