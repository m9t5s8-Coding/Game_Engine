{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "runtime",
      "displayName": "Sandbox runtime",
      "description": "Sandbox runtime only",
      "inherits": "default",
      "cacheVariables": {
        "BUILD_SANDBOX": "ON",
        "BUILD_EDITOR": "OFF",
        "BUILD_SERVER": "OFF",
        "BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "editor",
      "displayName": "AeroEditor",
      "description": "AeroEditor only",
      "inherits": "default",
      "cacheVariables": {
        "BUILD_EDITOR": "ON",
        "BUILD_SANDBOX": "OFF",
        "BUILD_SERVER": "OFF",
        "BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "editor-runtime",
      "displayName": "AeroEditor + Sandbox",
      "description": "Editor and Sandbox runtime",
      "inherits": "default",
      "cacheVariables": {
        "BUILD_EDITOR": "ON",
        "BUILD_SANDBOX": "ON",
        "BUILD_SERVER": "OFF",
        "BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "server",
      "displayName": "ServerSandbox",
      "description": "ServerSandbox only",
      "inherits": "default",
      "cacheVariables": {
        "BUILD_EDITOR": "OFF",
        "BUILD_SANDBOX": "OFF",
        "BUILD_SERVER": "ON",
        "BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "tools",
      "displayName": "Command-line tools",
      "description": "AssetPacker and engine asset packing",
      "inherits": "default",
      "cacheVariables": {
        "BUILD_EDITOR": "OFF",
        "BUILD_SANDBOX": "OFF",
        "BUILD_SERVER": "OFF",
        "BUILD_TOOLS": "ON"
      }
    },
    {
      "name": "full",
      "displayName": "Everything",
      "description": "Editor, Sandbox, ServerSandbox and tools",
      "inherits": "default",
      "cacheVariables": {
        "BUILD_EDITOR": "ON",
        "BUILD_SANDBOX": "ON",
        "BUILD_SERVER": "ON",
        "BUILD_TOOLS": "ON"
      }
    },
    {
      "name": "web",
      "displayName": "Web (Emscripten)",
      "description": "Sandbox for WebAssembly (run with emcmake)",
      "inherits": "default",
      "cacheVariables": {
        "BUILD_EDITOR": "OFF",
        "BUILD_SANDBOX": "ON",
        "BUILD_SERVER": "OFF",
        "BUILD_TOOLS": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "runtime",
      "configurePreset": "runtime"
    },
    {
      "name": "editor",
      "configurePreset": "editor"
    },
    {
      "name": "editor-runtime",
      "configurePreset": "editor-runtime"
    },
    {
      "name": "server",
      "configurePreset": "server"
    },
    {
      "name": "tools",
      "configurePreset": "tools"
    },
    {
      "name": "full",
      "configurePreset": "full"
    },
    {
      "name": "web",
      "configurePreset": "web"
    }
  ]
}
